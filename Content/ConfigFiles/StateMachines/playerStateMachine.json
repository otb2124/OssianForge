    {
      "from": "SprintRight",
      "to": "Jumping",
      "condition": {
        "copy": {
          "from": "Idle",
          "to": "Jumping"
        }
      }
    },
    {
      "from": "Idle",
      "to": "Falling",
      "condition": {
        "not": {
          "call": "OssianForge.Engine.Physics.PhysicsReflection.IsGrounded",
          "args": [ "$child.playerBodyMesh" ]
        }
      }
    },
    {
      "from": "Falling",
      "to": "Landing",
      "condition": {
        "call": "OssianForge.Engine.Physics.PhysicsReflection.IsGrounded",
        "args": [ "$child.playerBodyMesh" ]
      }
    },
    {
      "from": "Landing",
      "to": "Idle",
      "condition": {
        "call": "OssianForge.Engine.Nodes.NodeReflection.IsAnimationFinished",
        "args": [ "$child.playerBodyMesh", "remy.jump_landing" ]
      }
    },
    {
      "from": "Jumping",
      "to": "Falling",
      "condition": {
        "call": "OssianForge.Engine.Physics.PhysicsReflection.IsFalling",
        "args": [ "$child.playerBodyMesh" ]
      }
    }
  ]
}