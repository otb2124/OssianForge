{
  "id": "statemachine.player",
  "initial": "Idle",
  "states": [
    {
      "id": "Idle",
      "onEnter": [ "action.myActions.playAnimIdle" ]
    },
    {
      "id": "Falling",
      "onEnter": [ "action.myActions.playAnimFalling" ]
    },
    {
      "id": "WalkForward",
      "onEnter": [ "action.myActions.playAnimWalking" ],
      "onUpdate": [ "action.transform.transformBodyPositionCameraDirForward", "action.transform.setBodyYawForward" ]
    },
    {
      "id": "WalkBackward",
      "onEnter": [ "action.myActions.playAnimWalking" ],
      "onUpdate": [ "action.transform.transformBodyPositionCameraDirBackward", "action.transform.setBodyYawBackward" ]
    },
    { "id": "WalkLeft" },
    { "id": "WalkRight" }
  ],
  "transitions": [
    {
      "from": "Idle",
      "to": "Falling",
      "condition": {
        "not": {
          "call": "OssianForge.Engine.Physics.PhysicsReflection.IsGrounded",
          "args": [ "$child.playerBodyMesh" ]
        }
      }
    },
    {
      "from": "Falling",
      "to": "Idle",
      "condition": {
        "call": "OssianForge.Engine.Physics.PhysicsReflection.IsGrounded",
        "args": [ "$child.playerBodyMesh" ]
      }
    },
    {
      "from": "WalkForward",
      "to": "Falling",
      "condition": {
        "not": {
          "call": "OssianForge.Engine.Physics.PhysicsReflection.IsGrounded",
          "args": [ "$child.playerBodyMesh" ]
        }
      }
    },
    {
      "from": "WalkBackward",
      "to": "Falling",
      "condition": {
        "not": {
          "call": "OssianForge.Engine.Physics.PhysicsReflection.IsGrounded",
          "args": [ "$child.playerBodyMesh" ]
        }
      }
    },
    {
      "from": "WalkLeft",
      "to": "Falling",
      "condition": {
        "not": {
          "call": "OssianForge.Engine.Physics.PhysicsReflection.IsGrounded",
          "args": [ "$child.playerBodyMesh" ]
        }
      }
    },
    {
      "from": "WalkRight",
      "to": "Falling",
      "condition": {
        "not": {
          "call": "OssianForge.Engine.Physics.PhysicsReflection.IsGrounded",
          "args": [ "$child.playerBodyMesh" ]
        }
      }
    },
    {
      "from": "Idle",
      "to": "WalkForward",
      "condition": {
        "and": [
          {
            "call": "OssianForge.Engine.Inputs.KeyHandler.IsStateActive",
            "args": [ "walk_up" ]
          },
          {
            "call": "OssianForge.Engine.Physics.PhysicsReflection.IsGrounded",
            "args": [ "$child.playerBodyMesh" ]
          }
        ]
      }
    },
    {
      "from": "Idle",
      "to": "WalkBackward",
      "condition": {
        "and": [
          {
            "call": "OssianForge.Engine.Inputs.KeyHandler.IsStateActive",
            "args": [ "walk_down" ]
          },
          {
            "call": "OssianForge.Engine.Physics.PhysicsReflection.IsGrounded",
            "args": [ "$child.playerBodyMesh" ]
          }
        ]
      }
    },
    {
      "from": "Idle",
      "to": "WalkLeft",
      "condition": {
        "and": [
          {
            "call": "OssianForge.Engine.Inputs.KeyHandler.IsStateActive",
            "args": [ "walk_left" ]
          },
          {
            "call": "OssianForge.Engine.Physics.PhysicsReflection.IsGrounded",
            "args": [ "$child.playerBodyMesh" ]
          }
        ]
      }
    },
    {
      "from": "Idle",
      "to": "WalkRight",
      "condition": {
        "and": [
          {
            "call": "OssianForge.Engine.Inputs.KeyHandler.IsStateActive",
            "args": [ "walk_right" ]
          },
          {
            "call": "OssianForge.Engine.Physics.PhysicsReflection.IsGrounded",
            "args": [ "$child.playerBodyMesh" ]
          }
        ]
      }
    },
    {
      "from": "WalkForward",
      "to": "Idle",
      "condition": {
        "not": {
          "call": "OssianForge.Engine.Inputs.KeyHandler.IsStateActive",
          "args": [ "walk_up" ]
        }
      }
    },
    {
      "from": "WalkBackward",
      "to": "Idle",
      "condition": {
        "not": {
          "call": "OssianForge.Engine.Inputs.KeyHandler.IsStateActive",
          "args": [ "walk_down" ]
        }
      }
    },
    {
      "from": "WalkLeft",
      "to": "Idle",
      "condition": {
        "not": {
          "call": "OssianForge.Engine.Inputs.KeyHandler.IsStateActive",
          "args": [ "walk_left" ]
        }
      }
    },
    {
      "from": "WalkRight",
      "to": "Idle",
      "condition": {
        "not": {
          "call": "OssianForge.Engine.Inputs.KeyHandler.IsStateActive",
          "args": [ "walk_right" ]
        }
      }
    }
  ]
}