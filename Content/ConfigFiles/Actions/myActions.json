[
  {
    "id": "action.myActions.printHello",
    "call": "System.Console.WriteLine",
    "args": [ "$value.myActions.myValue" ]
  },
  {
    "id": "action.myActions.printHi",
    "call": "System.Console.WriteLine",
    "args": [ "Hi" ]
  },
  {
    "id": "action.myActions.getMyValue",
    "call": "OssianForge.Engine.Nodes.GetMyValue",
    "args": [ "$self", "Qos input" ],
    "storeValue": "value.myActions.myValue"
  },
  {
    "id": "action.myActions.walkStep",
    "call": "OssianForge.Engine.Nodes.NodeReflection.SetNodePropertyValue",
    "args": [ "$self", "PhysicsProperty", "ManualVelocity", "10,0,0" ]
  }
]