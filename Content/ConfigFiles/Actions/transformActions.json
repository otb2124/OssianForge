[
  {
    "id": "action.transform.jump",
    "call": "node.setValue",
    "args": [ "$child.playerBodyMesh", "RigidPhysicsProperty", "ManualImpulse", "0,5,0" ]
  },
  {
    "id": "action.transform.resetVelocity",
    "call": "node.callMethod",
    "args": [ "$child.playerBodyMesh", "RigidPhysicsProperty", "ResetVelocity"]
  },

  {
    "id": "action.transform.sprintForward",
    "call": "node.setValueCameraDirection",
    "args": [ "$child.playerBodyMesh", "RigidPhysicsProperty", "ManualVelocity", "0,0,-10", "playerCamera", "$delta" ]
  },
  {
    "id": "action.transform.sprintBackward",
    "call": "node.setValueCameraDirection",
    "args": [ "$child.playerBodyMesh", "RigidPhysicsProperty", "ManualVelocity", "0,0,10", "playerCamera", "$delta" ]
  },

  {
    "id": "action.transform.runForward",
    "call": "node.setValueCameraDirection",
    "args": [ "$child.playerBodyMesh", "RigidPhysicsProperty", "ManualVelocity", "0,0,-5.5", "playerCamera", "$delta" ]
  },
  {
    "id": "action.transform.runBackward",
    "call": "node.setValueCameraDirection",
    "args": [ "$child.playerBodyMesh", "RigidPhysicsProperty", "ManualVelocity", "0,0,5.5", "playerCamera", "$delta" ]
  },


  {
    "id": "action.transform.walkForward",
    "call": "node.setValueCameraDirection",
    "args": [ "$child.playerBodyMesh", "RigidPhysicsProperty", "ManualVelocity", "0,0,-2", "playerCamera", "$delta" ]
  },
  {
    "id": "action.transform.walkBackward",
    "call": "node.setValueCameraDirection",
    "args": [ "$child.playerBodyMesh", "RigidPhysicsProperty", "ManualVelocity", "0,0,2", "playerCamera", "$delta" ]
  },



  {
    "id": "action.transform.transformBodyPositionCameraDirForward",
    "call": "node.addValueCameraDirection",
    "args": [ "$child.playerBodyMesh", "TransformProperty", "Rotation", "0,0,2", "playerCamera", "$delta" ]
  },
  {
    "id": "action.transform.transformBodyPositionCameraDirBackward",
    "call": "node.addValueCameraDirection",
    "args": [ "$child.playerBodyMesh", "TransformProperty", "Rotation", "0,0,-2", "playerCamera", "$delta" ]
  },



  {
    "id": "action.transform.transformRotationMouseYawX",
    "call": "node.addValue",
    "args": [ "$self", "TransformProperty", "Rotation", "0,1,0", "$mouse_x", "$delta" ]
  },
  {
    "id": "action.transform.transformRotationMouseYawY",
    "call": "node.addValue",
    "args": [ "$self", "TransformProperty", "Rotation", "1,0,0", "$mouse_y", "$delta" ]
  },
  {
    "id": "action.transform.setBodyYawForward",
    "call": "node.setYawFromCamera",
    "args": [ "$child.playerBodyMesh", "TransformProperty", "Rotation", "playerCamera", 0.0 ]
  },
  {
    "id": "action.transform.setBodyYawBackward",
    "call": "node.setYawFromCamera",
    "args": [ "$child.playerBodyMesh", "TransformProperty", "Rotation", "playerCamera", 180.0 ]
  }
]