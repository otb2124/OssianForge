[
  {
    "id": "action.systemActions.setWindowVisibleFalse",
    "call": "window.isVisible",
    "args": [ false ]
  },
  {
    "id": "action.systemActions.setWindowVisibleTrue",
    "call": "window.isVisible",
    "args": [ true ]
  },
  {
    "id": "action.systemActions.addControlPropertyNoWriteToAll",
    "call": "node.addPropertyToAll",
    "args": [ "ControlProperty", "OnClick:action.systemActions.selectEditNode" ]
  },
  {
    "id": "action.systemActions.selectEditNode",
    "call": "EditModeScript.Select",
    "args": [ "$self" ]
  },
  {
    "id": "action.systemActions.storeCurrentEditNodeId",
    "call": "nodes.getValue",
    "args": [ "$self", "Id" ],
    "storeValue": "value.currentEditNode.id"
  }
]