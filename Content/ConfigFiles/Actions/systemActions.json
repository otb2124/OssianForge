[
  {
    "id": "action.systemActions.setWindowVisibleFalse",
    "call": "window.isVisible",
    "args": [ false ]
  },
  {
    "id": "action.systemActions.setWindowVisibleTrue",
    "call": "window.isVisible",
    "args": [ true ]
  },
  {
    "id": "action.systemActions.addControlPropertyNoWriteToAll",
    "call": "node.addPropertyToAll",
    "args": [ "ControlProperty", "OnClick:action.systemActions.setGizmoPositionAtNode" ]
  },
  {
    "id": "action.systemActions.setGizmoPositionAtNode",
    "call": "node.setValue",
    "args": [ "$id.gizmo_scene", "TransformProperty", "Position", "$self.properties.TransformProperty.Position" ]
  }
]